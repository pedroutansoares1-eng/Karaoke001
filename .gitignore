# cookies.json / cookies_netscape.txt guardam a sessão do YouTube (yt-dlp).
# Publicá-los equivale a entregar a conta.
.env
cookies*.txt
cookies*.json
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal

# ==========================================================================
# Biblioteca baixada e mídia (conteúdo de terceiros + seus dados)
# ==========================================================================
# data/ tem os MP3 baixados, os stems separados, letras e afinações.
# Além de ser conteúdo com direitos autorais, é a sua biblioteca pessoal.
data/

